from __future__ import annotations

import sys
from pathlib import Path
from typing import Sequence


def resolve_resource(
    *relative_parts: str,
    executable_path: str | Path | None = None,
    package_file: str | Path = __file__,
) -> Path | None:
    """Find an application resource in source-tree or Nuitka standalone layouts.

    Source mode resolves from the project root (two levels above src/guardian).
    A standalone build resolves first beside its executable, where Nuitka places
    the explicitly included ``assets`` and Sysmon XML resources.
    """
    if not relative_parts or any(Path(part).is_absolute() or ".." in Path(part).parts for part in relative_parts):
        return None

    executable = Path(executable_path if executable_path is not None else sys.argv[0])
    roots: list[Path] = []
    try:
        roots.append(executable.resolve().parent)
    except (OSError, RuntimeError):
        pass
    try:
        roots.append(Path(package_file).resolve().parents[2])
    except (OSError, RuntimeError, IndexError):
        pass

    seen: set[str] = set()
    for base in roots:
        key = str(base).casefold()
        if key in seen:
            continue
        seen.add(key)
        candidate = base.joinpath(*relative_parts)
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            continue
    return None
